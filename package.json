{
	"name": "sigdumb",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"start": "node server.mjs",
		"test": "npm run build:server && node --test",
		"test:client": "vitest run",
		"typecheck": "tsc --noEmit",
		"build:client": "vite build",
		"build:server": "tsc -p tsconfig.server.json",
		"build": "npm run build:client && npm run build:server",
		"format": "prettier --write src test vite.config.ts tsconfig*.json package.json",
		"format:check": "prettier --check src test vite.config.ts tsconfig*.json package.json"
	},
	"dependencies": {
		"@fastify/helmet": "^13.1.1",
		"@fastify/rate-limit": "^11.2.0",
		"@fastify/static": "^10.1.3",
		"@sinclair/typebox": "^0.34.52",
		"fastify": "^5.12.1",
		"qrcode": "1.5.4"
	},
	"devDependencies": {
		"@preact/preset-vite": "^2.10.6",
		"@types/node": "^26.2.0",
		"@types/qrcode": "^1.5.6",
		"preact": "^10.29.8",
		"prettier": "^3.9.6",
		"sass": "^1.103.1",
		"tsx": "^4.23.12",
		"typescript": "^7.0.2",
		"vite": "^8.2.2",
		"vitest": "^4.1.11"
	}
}
