# All settings are optional. DumbTalk generates its access token on first use
# and asks for Telegram credentials in the web onboarding flow.
#
# BIND_ADDRESS=0.0.0.0
# HOST_PORT=8787
# WIDGET_TOKEN=
# For KaiOS 2.5 devices: the served Origin header differs from the app:// and
# the connecting LAN host, so set PUBLIC_ORIGIN to the origin used to reach the
# backend (e.g. http://<pi-ip>:8787) to satisfy the backend's same-origin check
# for POST /api/setup/claim and other non-GET API requests.
# PUBLIC_ORIGIN=http://192.168.1.20:8787
DEVICE_NAME=DumbTalk
SIGNAL_CLI_AUTO_UPDATE=true
SIGNAL_CLI_UPDATE_MIN_AGE_HOURS=24
WACLI_DEVICE_LABEL=DumbTalk
WACLI_SYNC_MAX_MESSAGES=50000
WACLI_SYNC_MAX_DB_SIZE=1GB
